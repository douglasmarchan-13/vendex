# Copia este archivo a .env y completa los valores de tu proyecto
# Supabase Dashboard → Project Settings → API

SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave service_role: SOLO en el servidor, nunca en el frontend ni en git
SUPABASE_SERVICE_ROLE_KEY=

PORT=4000
# Orígenes permitidos (separados por coma). El frontend de Vite corre en 5173.
CORS_ORIGIN=http://localhost:5173

# Zona horaria del negocio: se usa para "hoy", vencimientos y agenda.
# Debe coincidir con app_settings.timezone en la base.
BUSINESS_TZ=America/Lima

# Autenticación propia: POST /api/auth/login devuelve un JWT (Authorization: Bearer <token>).
# false = modo demo: sin token se entra como gerente de la empresa legado; el vendedor se toma de la
#         cabecera X-Seller-Id o de DEFAULT_SELLER_ID. Con token, se usa el usuario del token.
REQUIRE_AUTH=false
DEFAULT_SELLER_ID=andres

# Secreto para firmar los JWT (mínimo 32 caracteres). Obligatorio con REQUIRE_AUTH=true y en producción.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración de la sesión: 30m, 8h, 7d...
JWT_TTL=8h

# URL pública del frontend: se usa en los enlaces de los correos (/registro y /restablecer-clave)
APP_URL=http://localhost:5173

# Correo. console = no envía, imprime el correo (con el enlace) en el log: solo desarrollo.
#         resend  = https://resend.com (requiere dominio verificado para MAIL_FROM).
MAIL_DRIVER=console
# RESEND_API_KEY=
# MAIL_FROM=Vendex <no-reply@tu-dominio.com>

# Permite POST /api/admin/reset (recarga los datos de demostración). Desactívalo en producción.
ALLOW_DEMO_RESET=true

# (Opcional) Cadena de conexión Postgres, solo para `npm run gen:types`
# Supabase Dashboard → Connect → Connection string
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.TU-PROYECTO.supabase.co:5432/postgres

# Tipo de cambio oficial: se trae al arrancar y cada RATES_SYNC_HOURS horas desde
# BCRP (Perú, TC SBS venta), BCB (Bolivia, TC oficial) y BCV (Venezuela).
# Solo se sobrescribe cuando el banco publica un valor nuevo: un ajuste manual se respeta hasta entonces.
RATES_AUTO_SYNC=true
RATES_SYNC_HOURS=3
