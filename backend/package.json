{
  "name": "vendex-backend",
  "private": true,
  "version": "0.2.0",
  "description": "API REST de Vendex (NestJS + TypeScript) sobre Supabase",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.3",
    "@nestjs/core": "^12.6.3",
    "@nestjs/platform-express": "^12.6.3",
    "@nestjs/swagger": "^12.1.3",
    "@supabase/supabase-js": "^2.119.2",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "jose": "^6.2.18",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "^12.6.3",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.4",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "typescript": "~6.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.2"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "vitest run",
    "gen:types": "node scripts/gen-types.mjs",
    "superadmin": "node scripts/superadmin.mjs",
    "test:unit": "vitest run test/unit"
  }
}
